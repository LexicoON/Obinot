    <string name="settings_dialog_fast_title">Modo Rápido</string>
    <string name="settings_dialog_fast_body">Usa el reconocimiento de voz integrado de tu teléfono. Es rápido y eficiente en batería, pero la precisión varía según el dispositivo y el idioma. No se guarda el audio.</string>
    <string name="settings_dialog_accurate_title">Modo Preciso</string>
    <string name="settings_dialog_accurate_body">Graba el audio completo y lo envía a la IA (Gemini o Groq) para una transcripción precisa. Requiere conexión a internet y se procesa al abrir la nota. El audio se guarda en tu dispositivo.</string>

    <string name="settings_dialog_providers">Proveedores de IA</string>
    <string name="settings_dialog_gemini_title">Google Gemini</string>
    <string name="settings_dialog_gemini_body">Ideal para contenido complejo: matemática, química y diagramas de Mermaid. Maneja audios muy largos sin límite de tamaño. Capa gratuita generosa.</string>
    <string name="settings_dialog_groq_title">Groq AI</string>
    <string name="settings_dialog_groq_body">Extremadamente rápido, ideal para el uso diario. Funciona con modelos de código abierto. Las cargas de audio están limitadas a 25 MB por archivo.</string>
    <string name="settings_dialog_dynamic_title">Dinámico (Beta)</string>
    <string name="settings_dialog_dynamic_body">Elige automáticamente el mejor proveedor para cada tarea, así ambas cuotas gratuitas duran más. Requiere que ambas claves API estén configuradas. Antes se llamaba "Mix" — es la misma función.</string>

    <string name="settings_dialog_tasks">Tareas de procesamiento</string>
    <string name="settings_dialog_tidy_title">Ordenar</string>
    <string name="settings_dialog_tidy_body">Corrige errores tipográficos, gramática y elimina muletillas. Conserva el significado y el tono originales. Ideal para limpiar borradores.</string>
    <string name="settings_dialog_summary_title">Resumir</string>
    <string name="settings_dialog_summary_body">Extrae la información central en un resumen conciso. Ideal para notas largas donde solo querés los puntos clave.</string>
    <string name="settings_dialog_analyze_title">Analizar</string>
    <string name="settings_dialog_analyze_body">Identifica los puntos principales, los sentimientos subyacentes y cualquier acción o decisión pendiente. Ideal para notas de reuniones o material de estudio.</string>

    <string name="settings_dialog_formats">Formatos de salida</string>
    <string name="settings_dialog_paragraphs_title">Párrafos</string>
    <string name="settings_dialog_paragraphs_body">Prosa continua con subtítulos. Ideal para lectura y contenido que fluye naturalmente (ensayos, diarios, historias).</string>
    <string name="settings_dialog_bullets_title">Puntos</string>
    <string name="settings_dialog_bullets_body">Puntos cortos y fáciles de escanear, organizados por encabezados. Ideal para referencia rápida, tareas y datos estructurados.</string>
    <string name="settings_dialog_formats_tip">Tip: combiná Ordenar + Puntos para checklists limpios. Combiná Resumir + Párrafos para un resumen ejecutivo legible.</string>

    <string name="settings_dialog_compression_body">Cuando el audio supera el límite de tamaño de una API, Obinot puede comprimirlo automáticamente antes de subirlo. Así las grabaciones largas funcionan con proveedores que tienen límites ajustados.</string>
    <string name="settings_dialog_compression_off_title">Apagada</string>
    <string name="settings_dialog_compression_off_body">Sin compresión. Los archivos de más de 25 MB fallan en Groq.</string>
    <string name="settings_dialog_compression_balanced_title">Equilibrada (24 MB)</string>
    <string name="settings_dialog_compression_balanced_body">La mejor calidad. Compresión mínima, apunta justo por debajo del límite.</string>
    <string name="settings_dialog_compression_max_title">Máxima (15 MB)</string>
    <string name="settings_dialog_compression_max_body">Archivos más chicos, sigue siendo ideal para voz. Útil para conexiones lentas.</string>
    <string name="settings_dialog_compression_tip">Tip: Gemini no tiene límite de tamaño. Si tenés Gemini configurado, podés dejar la compresión automática apagada para máxima calidad de audio.</string>

    <string name="settings_dialog_color_palette">Paleta de colores</string>
    <string name="settings_dialog_color_palette_body">Material 3 genera una paleta completa a partir de una semilla. Cada estilo cambia el ánimo manteniendo el contraste y la accesibilidad.\n\n• Tonal Spot: equilibrado, el default de Material.\n• Vibrant: más saturado y vivo.\n• Expressive: mayor contraste, acentos más audaces.\n• Fruit Salad: colorido, tres familias cromáticas distintas.\n• Neutral: colores suaves y apagados con baja saturación.\n• Fidelity: mantiene el color semilla cerca del original.\n• Monochrome: escala de grises, sin color.</string>

    <string name="settings_dialog_backup">Respaldo de notas</string>
    <string name="settings_dialog_backup_full_title">Respaldo completo (.obinotbak)</string>
    <string name="settings_dialog_backup_full_body">Exporta todas tus notas, audio, etiquetas (con sus colores) y tus preferencias. Las claves API nunca se incluyen. Este es el formato que usa Obinot 2.0+ y es la opción recomendada para migrar desde Binot 1.x a Obinot.</string>
    <string name="settings_dialog_backup_legacy_title">Respaldo heredado (.binotbak)</string>
    <string name="settings_dialog_backup_legacy_body">Exporta solo notas y audio, en el formato original de Binot 1.x. Usalo solo si necesitás restaurar el respaldo en el propio Binot 1.x. No se incluyen etiquetas ni preferencias.</string>

    <string name="settings_dialog_got_it">Entendido</string>

    <string name="settings_dialog_warning">Advertencia</string>
    <string name="settings_dialog_warning_body">La grabación se detendrá y se descartará. ¿Continuar?</string>
    <string name="settings_dialog_warning_continue">Continuar</string>
    <string name="settings_dialog_apply_title">¿Guardar y aplicar a todas las notas?</string>
    <string name="settings_dialog_apply_body">Esto guardará tus nuevas preferencias y reiniciará los resultados generados por IA en todas las notas previas. Se reprocesarán usando tu nueva configuración la próxima vez que las abras. Tus transcripciones originales están completamente a salvo.\n\n¿Continuar?</string>
    <string name="settings_dialog_apply_button">Guardar y aplicar</string>

